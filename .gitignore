# MkDocs 博客仓
# 基于 https://github.com/github/gitignore/blob/main/Python.gitignore
# （只保留博客相关规则；完整 Python 模板过宽）

# MkDocs 构建输出（部署时再生成）
/site

# 虚拟环境
.venv/
venv/
env/
ENV/

# 字节码
__pycache__/
*.py[cod]
*$py.class
*.pyo

# 测试 / 类型检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 环境变量（勿提交密钥）
.env
.envrc

# 编辑器 / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
